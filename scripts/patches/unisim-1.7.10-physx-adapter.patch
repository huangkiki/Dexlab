diff --git a/src/unisim/backend/isaacsim/sdf_collision.py b/src/unisim/backend/isaacsim/sdf_collision.py
new file mode 100644
index 0000000..362bcb9
--- /dev/null
+++ b/src/unisim/backend/isaacsim/sdf_collision.py
@@ -0,0 +1,71 @@
+"""Explicit MJCF SDF transport and native PhysX authoring on the cold path.
+
+The MJCF importer cannot consume ``type=sdf``. Its mesh transport is never the
+final collision representation: selected shapes are authored and audited as SDF.
+Resolution is a disclosed adapter approximation, not source SDF equivalence.
+"""
+from __future__ import annotations
+
+import xml.etree.ElementTree as ET
+from pathlib import Path
+from typing import Any
+
+SDF_RESOLUTION = 256
+SDF_SUBGRID_RESOLUTION = 6
+SDF_TRANSPORT_VERSION = 3
+
+
+def sdf_flags(record: dict[str, Any]) -> list[bool]:
+    flags = record.get("geom_sdf", [False] * len(record["geom_names"]))
+    if len(flags) != len(record["geom_names"]) or any(type(x) is not bool for x in flags):
+        raise ValueError("geom_sdf must contain one boolean per geometry")
+    return list(flags)
+
+
+def importer_source(source: str, destination: Path) -> str:
+    """Write an importer-only mesh spelling, retaining the original source."""
+    path = Path(source)
+    document = ET.parse(path)
+    geoms = [g for g in document.iter("geom") if g.get("type") == "sdf"]
+    if not geoms:
+        return source
+    for geom in geoms:
+        if not geom.get("mesh") or geom.find("plugin") is not None:
+            raise ValueError("PhysX SDF transport requires a mesh-backed, non-plugin SDF")
+        geom.set("type", "mesh")
+    if destination.parent.resolve() != path.parent.resolve():
+        raise ValueError("MJCF importer transport must remain beside source mesh resources")
+    document.write(destination, encoding="utf-8")
+    return str(destination)
+
+
+def author_sdf(collision: Any) -> None:
+    from pxr import PhysxSchema, UsdGeom, UsdPhysics
+
+    if not collision.IsA(UsdGeom.Mesh):
+        raise RuntimeError("SDF transport did not produce a native mesh collider")
+    UsdPhysics.MeshCollisionAPI.Apply(collision).CreateApproximationAttr().Set(
+        PhysxSchema.Tokens.sdf
+    )
+    api = PhysxSchema.PhysxSDFMeshCollisionAPI.Apply(collision)
+    api.CreateSdfResolutionAttr().Set(SDF_RESOLUTION)
+    api.CreateSdfSubgridResolutionAttr().Set(SDF_SUBGRID_RESOLUTION)
+
+
+def read_sdf(collision: Any) -> dict[str, Any]:
+    from pxr import PhysxSchema, UsdGeom, UsdPhysics
+
+    if not collision.IsA(UsdGeom.Mesh) or not collision.HasAPI(
+        PhysxSchema.PhysxSDFMeshCollisionAPI
+    ):
+        raise RuntimeError("Requested SDF collider is missing its native mesh API")
+    api = PhysxSchema.PhysxSDFMeshCollisionAPI(collision)
+    values = {
+        "approximation": str(UsdPhysics.MeshCollisionAPI(collision).GetApproximationAttr().Get()),
+        "resolution": api.GetSdfResolutionAttr().Get(),
+        "subgrid_resolution": api.GetSdfSubgridResolutionAttr().Get(),
+    }
+    if values != {"approximation": "sdf", "resolution": SDF_RESOLUTION,
+                  "subgrid_resolution": SDF_SUBGRID_RESOLUTION}:
+        raise RuntimeError("Native SDF approximation or resolution differs from request")
+    return values
