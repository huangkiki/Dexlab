@@ -0,0 +1,99 @@
+"""Opt-in force-contact material semantics without loading a native SDK."""
+
+from __future__ import annotations
+
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from unisim.backend.isaacsim import physx_solver as solver
+
+
+@pytest.mark.parametrize("stiffness,damping", [(5000, 2), (0, 0)])
+def test_material_options_round_trip(stiffness, damping):
+    config = solver.PhysxSolverConfig(
+        compliant_contact_stiffness=stiffness, compliant_contact_damping=damping
+    )
+    assert solver.PhysxSolverConfig.from_payload(config.to_payload()) == config
+
+
+@pytest.mark.parametrize(
+    "stiffness,damping",
+    [
+        (1, None),
+        (None, 1),
+        (-1, 0),
+        (1, -1),
+        (0, 1),
+        (True, 0),
+        (1, float("nan")),
+        (float("inf"), 1),
+    ],
+)
+def test_invalid_material_options_fail_before_worker(stiffness, damping):
+    with pytest.raises((TypeError, ValueError)):
+        solver.PhysxSolverConfig(
+            compliant_contact_stiffness=stiffness, compliant_contact_damping=damping
+        )
+
+
+class Attribute:
+    def __init__(self):
+        self.value = None
+
+    def Set(self, value):  # noqa: N802 -- match the public USD API
+        self.value = value
+
+    def Get(self):  # noqa: N802 -- match the public USD API
+        return self.value
+
+
+class Material:
+    def __init__(self):
+        self.attributes = {}
+
+    def HasAPI(self, _api):  # noqa: N802 -- match the public USD API
+        return bool(self.attributes)
+
+
+class MaterialAPI:
+    def __init__(self, material):
+        self.material = material
+
+    @classmethod
+    def Apply(cls, material):  # noqa: N802 -- match the public USD API
+        return cls(material)
+
+    def __getattr__(self, name):
+        key = name.removeprefix("Create").removeprefix("Get")
+        return lambda: self.material.attributes.setdefault(key, Attribute())
+
+
+def test_authored_materials_read_back_and_mixed_semantics_fail(monkeypatch):
+    materials = [Material(), Material()]
+    monkeypatch.setitem(
+        sys.modules,
+        "pxr",
+        SimpleNamespace(PhysxSchema=SimpleNamespace(PhysxMaterialAPI=MaterialAPI)),
+    )
+    monkeypatch.setattr(solver, "_collision_materials", lambda _stage: materials)
+    solver.apply_compliant_materials(None, 5000, 2)
+    assert solver.read_compliant_materials(None) == {
+        "compliant_contact_stiffness": 5000,
+        "compliant_contact_damping": 2,
+    }
+    changes = {
+        "CompliantContactStiffnessAttr": 6000,
+        "CompliantContactDampingAttr": None,
+        "CompliantContactAccelerationSpringAttr": True,
+        "RestitutionCombineModeAttr": "multiply",
+        "DampingCombineModeAttr": "max",
+    }
+    for key, value in changes.items():
+        attribute = materials[1].attributes[key]
+        old = attribute.Get()
+        attribute.Set(value)
+        with pytest.raises(RuntimeError):
+            solver.read_compliant_materials(None)
+        attribute.Set(old)
