+        api.CreateCompliantContactDampingAttr().Set(float(damping))
+        api.CreateCompliantContactAccelerationSpringAttr().Set(False)
+        api.CreateRestitutionCombineModeAttr().Set("average")
+        api.CreateDampingCombineModeAttr().Set("average")
