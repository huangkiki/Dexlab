+@pytest.mark.parametrize("enabled", [False, True])
+def test_factory_forwards_external_force_option(monkeypatch, enabled):
+    recorded = {}
+
+    class Recorder:
+        def __init__(self, *args, **kwargs):
+            recorded.update(kwargs)
+
+    monkeypatch.setattr("unisim.backend.isaacsim.backend.IsaacSimBackend", Recorder)
+    create_backend(
+        "isaacsim", None, 1, 0.001, worker_command=["true"],
+        isaacsim_external_forces_every_iteration=enabled,
+    )
+    assert recorded["external_forces_every_iteration"] is enabled
