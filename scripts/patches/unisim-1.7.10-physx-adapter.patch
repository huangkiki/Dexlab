+@pytest.mark.parametrize(
+    "inertial",
+    [
+        "",
+        '<inertial pos="0.000123456789012345 0 -0.000987654321098765" '
+        'mass="0.400000123456789" '
+        'diaginertia="0.00010666666666666668 0.00011666666666666668 0.00012666666666666668" '
+        'quat="0.9238795325112867 0 0.3826834323650898 0"/>',
+        '<inertial pos="0.000123456789012345 0 0" mass="0.400000123456789" '
+        'fullinertia="0.00011 0.00012 0.00013 0.000001234567890123 0.000002 0"/>',
+    ],
+)
+def test_exported_inertials_preserve_compiled_double_precision(tmp_path, inertial):
+    import mujoco
+
+    source = tmp_path / "precise.xml"
+    source.write_text(
+        '<mujoco><worldbody><body name="cube"><freejoint/>'
+        + inertial
+        + '<geom type="box" size="0.02 0.02 0.02" mass="0.4"/>'
+        "</body></worldbody></mujoco>"
+    )
+    intended = mujoco.MjModel.from_xml_path(str(source))
+    prepared = prepare_worker_scene(
+        SceneCfg(
+            entity_assets=(
+                SceneEntitySpec(
+                    "object",
+                    ModelSourceDescriptor(str(source)),
+                    kind="rigid",
+                ),
+            )
+        ),
+        1,
+        0.0005,
+    )
+    try:
+        entry = prepared.payload["scene_entities"][0]
+        actual = mujoco.MjModel.from_xml_path(entry["sources"][0])
+        for field in ("body_mass", "body_ipos", "body_inertia"):
+            np.testing.assert_allclose(
+                getattr(actual, field)[1:],
+                getattr(intended, field)[1:],
+                rtol=2e-14,
+                atol=1e-18,
+            )
+
+        # Quaternion signs are equivalent; compare the physical inertia tensor.
+        def tensor(model):
+            rotation = np.empty(9)
+            mujoco.mju_quat2Mat(rotation, model.body_iquat[1])
+            rotation = rotation.reshape(3, 3)
+            return rotation @ np.diag(model.body_inertia[1]) @ rotation.T
+
+        np.testing.assert_allclose(tensor(actual), tensor(intended), rtol=2e-13, atol=1e-18)
+    finally:
+        prepared.close()
+
