+"""SDF intent, source-preserving transport and optional geometry alignment."""
+import xml.etree.ElementTree as ET
+from types import SimpleNamespace
+
+import pytest
+
+from unisim.backend.isaacsim.scene_worker import _normalized_variant_record
+from unisim.backend.isaacsim.sdf_collision import importer_source, sdf_flags
+
+
+def test_transport_keeps_original_and_relative_mesh_resources(tmp_path):
+    source = tmp_path / "source.xml"
+    original = ('<mujoco><compiler meshdir="meshes"/><asset>'
+                '<mesh name="a" file="shape.obj"/></asset><worldbody><body>'
+                '<inertial mass=".1" pos="0 0 0" diaginertia="1 2 3"/>'
+                '<geom name="s" type="sdf" mesh="a"/><geom type="sphere" size=".1"/>'
+                '</body></worldbody></mujoco>')
+    source.write_text(original)
+    target = tmp_path / "transport.xml"
+    assert importer_source(str(source), target) == str(target)
+    assert source.read_text() == original
+    document = ET.parse(target)
+    assert [g.get("type") for g in document.iter("geom")] == ["mesh", "sphere"]
+    mesh = document.find("./asset/mesh")
+    assert mesh is not None and mesh.get("file") == "shape.obj"
+    inertial = document.find("./worldbody/body/inertial")
+    assert inertial is not None and inertial.get("mass") == ".1"
+
+
+@pytest.mark.parametrize("geom", ['<geom type="sdf"/>',
+                                  '<geom type="sdf" mesh="a"><plugin plugin="custom"/></geom>'])
+def test_unsupported_sdf_does_not_silently_become_mesh(tmp_path, geom):
+    source = tmp_path / "source.xml"
+    source.write_text(f"<mujoco><worldbody><body>{geom}</body></worldbody></mujoco>")
+    with pytest.raises(ValueError, match="mesh-backed"):
+        importer_source(str(source), tmp_path / "transport.xml")
+
+
+def test_non_sdf_import_uses_original_file(tmp_path):
+    source = tmp_path / "source.xml"
+    source.write_text('<mujoco><worldbody><geom type="mesh" mesh="a"/></worldbody></mujoco>')
+    assert importer_source(str(source), tmp_path / "unused.xml") == str(source)
+    assert not (tmp_path / "unused.xml").exists()
+
+
+@pytest.mark.parametrize("flags", [[1], [], [True, False]])
+def test_malformed_sdf_flags_are_rejected(flags):
+    with pytest.raises(ValueError, match="one boolean"):
+        sdf_flags({"geom_names": ["g"], "geom_sdf": flags})
+
+
+def test_missing_optional_slot_does_not_shift_sdf_intent():
+    entity = SimpleNamespace(geoms=[SimpleNamespace(name=n, body_name="body")
+                                   for n in ["optional", "pad"]])
+    record = {"geom_names": ["pad"], "geom_body_names": ["body"],
+              "geom_contype": [1], "geom_conaffinity": [1],
+              "geom_friction": [[.5, 0, 0]], "geom_sdf": [True]}
+    result = _normalized_variant_record(entity, record)
+    assert result["geom_sdf"] == [False, True]
+    assert result["geom_placeholders"] == [1, 0]
+    assert record["geom_sdf"] == [True]
