+@pytest.mark.parametrize("enabled", [False, True])
+def test_external_force_option_roundtrip(monkeypatch, enabled):
+    config = PhysxSolverConfig(external_forces_every_iteration=enabled)
+    assert PhysxSolverConfig.from_payload(config.to_payload()) == config
+    _pxr, stage, _shapes, _bodies = _fake_stage(monkeypatch)
+    apply_external_forces_every_iteration(stage, enabled)
+    values = read_engine_solver_values(
+        stage, include_contact_offset=False, include_external_forces_every_iteration=True
+    )
+    assert values["external_forces_every_iteration"] is enabled
+    _backend(config)._validate_solver_readback(_meta(values, ["external_forces_every_iteration"]))
+    values["external_forces_every_iteration"] = not enabled
+    with pytest.raises(IsaacSimWorkerError):
+        _backend(config)._validate_solver_readback(
+            _meta(values, ["external_forces_every_iteration"])
+        )
+
+
+@pytest.mark.parametrize("bad", [0, 1, "true", float("nan")])
+def test_external_force_option_rejects_non_boolean(bad):
+    with pytest.raises(TypeError):
+        PhysxSolverConfig.from_payload({"external_forces_every_iteration": bad})
+    assert not solver_value_matches("external_forces_every_iteration", True, bad)
+
