+"""Ragged native contact buffers must not hide data loss or alias SDK counts."""
+
+import numpy as np
+import pytest
+
+from unisim.backend.isaacsim.contact_details import ContactDetails, compact_patches
+
+
+def test_only_initialized_rows_are_read_and_body_filters_are_preserved():
+    buffer = np.full((8, 3), np.nan)
+    buffer[3:5] = [[1, 2, 3], [4, 5, 6]]
+    owners, values = compact_patches(
+        (buffer, np.array([[0, 2]]), np.array([[9999, 3]])), [10, 20], 8
+    )
+    np.testing.assert_array_equal(owners, [20, 20])
+    np.testing.assert_array_equal(values[0], buffer[3:5])
+    buffer[3:5] = 0
+    assert values[0][0, 0] == 1
+
+
+@pytest.mark.parametrize("counts,starts", [
+    ([[-1, 0]], [[0, 0]]),
+    ([[1, 0]], [[-1, 0]]),
+    ([[1, 0]], [[7, 0]]),  # Full capacity might mean truncated native output.
+    ([[2, 1]], [[0, 1]]),
+    ([[1.0, 0]], [[0, 0]]),
+    ([[1]], [[0]]),
+])
+def test_invalid_or_saturated_buffers_fail_closed(counts, starts):
+    with pytest.raises(ValueError):
+        compact_patches((np.zeros((8, 3)), np.array(counts), np.array(starts)), [10, 20], 8)
+
+
+def test_nonfinite_active_contact_cannot_be_dropped():
+    with pytest.raises(ValueError, match="nonfinite"):
+        compact_patches((np.full((8, 3), np.nan), np.array([[1]]), np.array([[0]])), [10], 8)
+
+
+class Tensor:
+    def __init__(self, value):
+        self.value = value
+
+    def detach(self):
+        return self
+
+    def cpu(self):
+        return self
+
+    def numpy(self):
+        return self.value
+
+
+def test_friction_query_reusing_counts_does_not_reassign_normal_contact():
+    class View:
+        counts = np.zeros((1, 2), dtype=np.uint32)
+        starts = np.zeros((1, 2), dtype=np.uint32)
+
+        def get_contact_data(self, dt):
+            self.counts[:] = [[1, 0]]
+            force = np.zeros((8, 1))
+            normal = np.zeros((8, 3))
+            force[0, 0], normal[0, 2] = 2, 1
+            return tuple(Tensor(x) for x in (
+                force, np.zeros((8, 3)), normal, np.zeros((8, 1)), self.counts, self.starts
+            ))
+
+        def get_friction_data(self, dt):
+            self.counts[:] = [[0, 1]]
+            force = np.zeros((8, 3))
+            force[0, 0] = -.5
+            return tuple(Tensor(x) for x in (force, np.zeros((8, 3)), self.counts, self.starts))
+
+    recorder = ContactDetails(View(), [10, 20], 8)
+    recorder.poll(.001)
+    np.testing.assert_array_equal(recorder.latest["normal_body_ids"], [10])
+    np.testing.assert_array_equal(recorder.latest["friction_body_ids"], [20])
+    np.testing.assert_array_equal(recorder.latest["normal_force"], [[0, 0, 2]])
+    np.testing.assert_array_equal(recorder.latest["friction_force"], [[-.5, 0, 0]])
