+"""Factory spelling errors must never silently select different native physics."""
+from __future__ import annotations
+
+import pytest
+
+from unisim import create_backend
+from unisim.scene import SceneCfg
+
+
+@pytest.mark.parametrize("name", ["integrator", "constraint_solver", "friction_cone",
+                                  "solver_iterations", "device_id"])
+def test_genesis_factory_rejects_shadowed_constructor_options(name):
+    with pytest.raises(TypeError, match="requires genesis_" + name):
+        create_backend("genesis", scene=SceneCfg(model_file="unused.xml"), **{name: "value"})
+
+
+def test_genesis_factory_forwards_prefixed_cone(monkeypatch):
+    import unisim.backend.genesis.backend as module
+
+    captured = {}
+
+    def constructor(scene, num_envs, dt, **kwargs):
+        captured.update(kwargs)
+        return object()
+
+    monkeypatch.setattr(module, "GenesisBackend", constructor)
+    create_backend("genesis", scene=SceneCfg(model_file="unused.xml"),
+                   genesis_friction_cone="elliptic")
+    assert captured["friction_cone"] == "elliptic"
