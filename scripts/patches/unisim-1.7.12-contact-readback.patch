index 0000000000000000000000000000000000000000..637bc1f20e807c760dbaff024b7eb4131da55bb7
--- /dev/null
+++ b/src/unisim/backend/genesis/geometry_identity.py
@@ -0,0 +1,114 @@
+"""Cold-path primitive identity when mesh caches omit or reuse source names."""
+from __future__ import annotations
+
+from typing import Any
+
+import numpy as np
+
+from unisim.utils.rotation import np_matrix_from_quat
+
+
+def pose_matrix(position: Any, quaternion: Any) -> np.ndarray:
+    result = np.eye(4)
+    result[:3, :3] = np_matrix_from_quat(np.asarray(quaternion))
+    result[:3, 3] = position
+    return result
+
+
+def authored_geom_pose(native: Any, variant: int) -> np.ndarray:
+    """Undo 1.4.3's static free-root alignment, including fixed child frames."""
+    pose = pose_matrix(native.init_pos, native.init_quat)
+    link = native.link
+    if not hasattr(link, "aligned"):
+        return pose  # Earlier runtimes do not re-express collision geometry.
+    entity = link.entity
+    root_to_link = np.eye(4)
+    while link.parent_idx != -1:
+        root_to_link = pose_matrix(link.desc.pos, link.desc.quat) @ root_to_link
+        link = entity.links[link.parent_idx - entity.link_start]
+    if not link.aligned:
+        return pose
+    # Native descriptions retain each variant's actual anchor after build.
+    # The root offset composes morph offset with inertial alignment; remove
+    # only the former, then conjugate alignment into this link's local frame.
+    description = entity._desc.variants[variant] if entity._desc.variants else link.desc
+    offset = pose_matrix(description.offset_pos, description.offset_quat)
+    native_morph = entity.morphs[variant]
+    morph = pose_matrix(native_morph.offset_pos, native_morph.offset_quat)
+    alignment = np.linalg.solve(morph, offset)
+    return np.linalg.solve(root_to_link, alignment @ root_to_link @ pose)
+
+
+def primitive_matches(native: Any, metadata: Any, source_id: int, variant: int) -> bool:
+    """Require native type, dimensions and local pose, never approximate names."""
+    # MJCF geom enum values are stable source-format identities, not engine IDs.
+    kind = metadata.geom_types[source_id]
+    size = metadata.geom_sizes[source_id]
+    if kind == 0:
+        expected_type, dimensions = "PLANE", np.array([0., 0., 1.])
+    elif kind == 2:
+        expected_type, dimensions = "SPHERE", size[:1]
+    elif kind == 6:
+        expected_type, dimensions = "BOX", 2 * size
+    else:
+        return False
+    if getattr(native.type, "name", None) != expected_type:
+        return False
+    data = np.asarray(native.data)
+    position, quaternion = np.asarray(native.init_pos), np.asarray(native.init_quat)
+    if data.ndim != 1 or data.size < dimensions.size:
+        return False
+    if position.shape != (3,) or quaternion.shape != (4,):
+        return False
+    actual_pose = authored_geom_pose(native, variant)
+    expected_pose = pose_matrix(metadata.geom_positions[source_id],
+                                metadata.geom_quaternions[source_id])
+    # Source metadata preserves compiler precision for identity, independently
+    # of the selected state-cache precision. This is not a physics tolerance.
+    def same(left: np.ndarray, right: np.ndarray) -> bool:
+        return bool(np.allclose(left, right, rtol=0, atol=1e-12))
+    return (
+        same(data[:dimensions.size], dimensions)
+        and same(actual_pose, expected_pose)
+    )
+
+
+def matches(native: Any, metadata: Any, source_id: int, name: str, body: str,
+            variant: int = 0) -> bool:
+    """Bind primitives by body, shape and pose; mesh-cache names are not identities."""
+    if str(native.link.name) != body:
+        return False
+    # Identical cached primitive meshes can retain the first instance's name,
+    # even on another link. Prefer physical identity when all native fields
+    # exist; callers still reject multiple matches on the same body.
+    if (metadata is not None
+            and all(hasattr(native, field) for field in ("type", "data", "init_pos", "init_quat"))
+            and metadata.geom_types[source_id] in (0, 2, 6)):
+        return primitive_matches(native, metadata, source_id, variant)
+    native_name = str(native.metadata.get("name", ""))
+    if native_name:
+        return native_name == name
+    return False
+
+
+def native_property(native: Any, name: str) -> np.ndarray:
+    """1.4.3 moved static properties to live getters; retain older runtime support."""
+    getter = getattr(native, "get_" + name, None)
+    value: Any = getter() if callable(getter) else getattr(native, name)
+    if hasattr(value, "detach"):
+        value = value.detach().cpu().numpy()
+    return np.asarray(value, dtype=np.float64)
+
+
+def body_frame_inertia(entity: Any, link: Any, num_envs: int) -> np.ndarray:
+    """Rotate 1.4.3's live inertial-frame tensor using its live inertial quaternion."""
+    from genesis.utils.misc import qd_to_torch
+
+    inertia = entity.get_links_inertia(links_idx_local=[link.idx_local]).detach().cpu().numpy()
+    inertia = inertia.reshape(-1, 3, 3)
+    quaternions = qd_to_torch(entity.solver.dyn_info.links.inertial_quat, copy=True)
+    quaternions = quaternions[link.idx].detach().cpu().numpy().reshape(-1, 4)
+    if inertia.shape[0] not in (1, num_envs) or quaternions.shape[0] not in (1, num_envs):
+        raise RuntimeError("Genesis inertial readback has an unexpected environment axis")
+    rotation = np.stack([np_matrix_from_quat(value) for value in quaternions])
+    return np.broadcast_to(rotation @ inertia @ rotation.transpose(0, 2, 1), (num_envs, 3, 3))
