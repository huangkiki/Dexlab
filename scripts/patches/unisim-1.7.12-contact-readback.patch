--- /dev/null
+++ b/tests/adapters/genesis/test_host_clock.py
@@ -0,0 +1,78 @@
+"""Host lifecycle clock boundaries, independent of optional native runtimes."""
+from __future__ import annotations
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import numpy as np
+import pytest
+
+from unisim.backend.genesis.backend import GenesisBackend
+
+
+def _backend(dt: float, dtype=np.float64) -> GenesisBackend:
+    backend = object.__new__(GenesisBackend)
+    backend._np_dtype = np.dtype(dtype)
+    backend._num_envs = 2
+    backend._sim_dt = dt
+    backend._metadata = SimpleNamespace(nq=0, nv=0, actuator_names=())
+    backend._qpos_cache = (None, np.empty((2, 0), dtype=dtype))
+    backend._qvel_cache = (None, np.empty((2, 0), dtype=dtype))
+    backend._time_cache = np.zeros(2, dtype=dtype)
+    backend._time_origin = np.zeros(2, dtype=np.float64)
+    backend._time_steps = np.zeros(2, dtype=np.int64)
+    backend._contact_sensor_rows_valid = np.zeros(2, dtype=bool)
+    backend._portable_mode = False
+    backend._pre_step_control_fn = None
+    backend._entity = Mock()
+    backend._require_state = Mock()
+    backend._push_control = Mock()
+    backend._physics_substep = Mock()
+    backend._refresh_host_cache = Mock()
+    backend._to_device = lambda value: value
+    return backend
+
+
+@pytest.mark.parametrize("dt", [0.001, 0.0005, 0.00025])
+@pytest.mark.parametrize("dtype", [np.float32, np.float64])
+def test_single_and_batched_steps_have_identical_window_membership(dt, dtype):
+    single, batched = _backend(dt, dtype), _backend(dt, dtype)
+    ctrl = np.empty((2, 0), dtype=dtype)
+    last_step = 0
+    for boundary in (2.0, 3.0, 3.8, 4.0):
+        end_step = round(boundary / dt)
+        for _ in range(end_step - last_step):
+            single.step(ctrl)
+        batched.step(ctrl, nsteps=end_step - last_step)
+        expected = np.full(2, end_step * dt, dtype=dtype)
+        np.testing.assert_array_equal(single.get_physics_state()[:, 0], expected)
+        np.testing.assert_array_equal(batched.get_physics_state()[:, 0], expected)
+        assert np.all(single.get_physics_state()[:, 0] >= dtype(boundary))
+        last_step = end_step
+
+
+def test_selected_reset_and_playback_restore_keep_independent_origins():
+    backend = _backend(0.0005)
+    ctrl = np.empty((2, 0))
+    backend.set_physics_state(np.array([[1.25], [5.75]]))
+    backend.step(ctrl, nsteps=4000)
+    np.testing.assert_array_equal(backend.get_physics_state()[:, 0], [3.25, 7.75])
+    backend.set_state(np.array([0]), np.empty((1, 0)), np.empty((1, 0)))
+    for _ in range(4000):
+        backend.step(ctrl)
+    np.testing.assert_array_equal(backend.get_physics_state()[:, 0], [2.0, 9.75])
+    backend.set_state(np.array([], dtype=int), np.empty((0, 0)), np.empty((0, 0)))
+    np.testing.assert_array_equal(backend.get_physics_state()[:, 0], [2.0, 9.75])
+
+
+def test_tensor_to_host_barrier_rebases_clock_without_changing_received_time():
+    backend = _backend(0.0005)
+    tensor = Mock()
+    tensor.detach.return_value.cpu.return_value.numpy.return_value = np.array([2.5, 8.5])
+    backend._tensor_time = tensor
+    backend._host_cache_stale = True
+    backend._sync_host_cache_from_tensor()
+    np.testing.assert_array_equal(backend.get_physics_state()[:, 0], [2.5, 8.5])
+    for _ in range(4000):
+        backend.step(np.empty((2, 0)))
+    np.testing.assert_array_equal(backend.get_physics_state()[:, 0], [4.5, 10.5])
