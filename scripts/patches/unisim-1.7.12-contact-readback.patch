+"""Initial native readbacks, copied before any caller reset or randomization."""
+from __future__ import annotations
+
+from typing import Any
+
+import numpy as np
+
+from unisim.inspection import ConfigurationField, ConfigurationProvenance, ImportReport
+
+
+def force_limit_values(value: Any) -> Any:
+    """Represent native unbounded drive limits without accepting NaN observations."""
+    array = np.asarray(value.detach().cpu() if hasattr(value, "detach") else value)
+    if np.isnan(array).any():
+        raise ValueError("Genesis drive limits contain NaN")
+    if array.ndim:
+        return [force_limit_values(row) for row in array]
+    number = float(array)
+    return "+inf" if number == np.inf else "-inf" if number == -np.inf else number
+
+
+def optional_readback(owner: Any, *names: str) -> Any:
+    """Missing native getters remain missing, including older runtime releases."""
+    for name in names:
+        getter = getattr(owner, name, None)
+        if callable(getter):
+            value: Any = getter()
+            return value.tolist()
+    return None
+
+
+def configuration_report(backend: Any) -> ImportReport:
+    """Keep unmeasured common settings unknown; expose native values with provenance."""
+    gs, scene = backend._gs, backend._scene
+    source = (ConfigurationProvenance(
+        "engine_readback", "Genesis initialized runtime and materialized rigid solver getters"
+    ),)
+    fields = list(ImportReport.unknown("genesis").fields)
+    actual_dtype = getattr(gs, "np_float", None)
+    for name, requested, effective in (
+        ("native_precision", str(backend._np_dtype),
+         None if actual_dtype is None else str(np.dtype(actual_dtype))),
+        ("native_device", str(backend._device),
+         None if getattr(gs, "device", None) is None else str(gs.device)),
+        ("native_deterministic_algorithms", backend._use_deterministic_algorithms,
+         getattr(gs, "use_deterministic_algorithms", None)),
+    ):
+        fields.append(ConfigurationField(
+            name, requested=requested, effective=effective,
+            difference="unknown" if effective is None else (
+                "exact" if effective == requested else "overridden"
+            ), provenance=source,
+        ))
+    # Fake cold-path runtimes used by contract tests need not expose a solver.
+    # Runtime qualification requires these fields to contain actual values.
+    solver = getattr(scene, "rigid_solver", None)
+    if solver is not None:
+        native_options = solver._options.model_dump(mode="json")
+        requested_cone = backend._requested_friction_cone
+        effective_cone = getattr(solver._options.friction_cone, "name", None)
+        fields.append(ConfigurationField(
+            "native_friction_cone", requested=requested_cone, effective=effective_cone,
+            difference="unknown" if effective_cone is None or requested_cone is None else (
+                "exact" if effective_cone == requested_cone else "overridden"
+            ), provenance=source,
+        ))
+        fields.append(ConfigurationField(
+            "native_rigid_options", effective=native_options, provenance=source,
+            reason="Native option names retain Genesis semantics; no material equivalence claimed.",
+        ))
+        fields.append(ConfigurationField(
+            "native_gravity", effective=solver.get_gravity().tolist(), provenance=source,
+            unit="m/s^2", frame="world",
+        ))
+    entities = {}
+    for name, runtime in backend._entity_runtimes.items():
+        if runtime.is_visual_mirror:
+            continue
+        entity = runtime.entity
+        values = {
+            "link_names": [link.name for link in entity.links],
+            "mass": optional_readback(entity, "get_links_mass", "get_links_inertial_mass"),
+            "inertia": optional_readback(entity, "get_links_inertia"),
+            "joints": {joint.name: {"sol_params": optional_readback(joint, "get_sol_params")}
+                       for joint in entity.joints},
+        }
+        if entity.n_dofs:
+            values.update({
+                "armature": entity.get_dofs_armature().tolist(),
+                "damping": entity.get_dofs_damping().tolist(),
+                "frictionloss": entity.get_dofs_frictionloss().tolist(),
+                "kp": entity.get_dofs_kp().tolist(), "kv": entity.get_dofs_kv().tolist(),
+                "force_range": [
+                    force_limit_values(value) for value in entity.get_dofs_force_range()
+                ],
+            })
+        entities[name] = values
+    if entities:
+        fields.append(ConfigurationField(
+            "native_entities", effective=entities, provenance=source,
+            reason="Arrays follow native entity link/DOF order; initial materialization only.",
+        ))
+    return ImportReport("genesis", tuple(fields), lifecycle="materialization")
