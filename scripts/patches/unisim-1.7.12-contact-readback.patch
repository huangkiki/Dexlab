index 0000000000000000000000000000000000000000..7569dfe8a6e8673624ee583909c0bb120c09f6e9
--- /dev/null
+++ b/src/unisim/contacts.py
@@ -0,0 +1,122 @@
+"""Detached per-contact observations with explicit geometry and force epochs."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+
+@dataclass(frozen=True)
+class ContactReadbackCapabilities:
+    """Native rigid-contact fields available through ``get_contact_snapshot``.
+
+    Support is a declaration, not a proof of physical accuracy or equivalence.
+    Unsupported fields stay ``None``; adapters must never replace them with zero.
+    """
+
+    supported: bool = False
+    normal: bool = False
+    signed_distance: bool = False
+    torque: bool = False
+    body_net_force: bool = False
+
+
+@dataclass(frozen=True)
+class ContactSnapshot:
+    """All rigid contacts from the last solve, as detached NumPy arrays.
+
+    ``state_time``, ``geometry_time``, ``force_start_time``, ``force_end_time``
+    and ``available`` have shape (num_envs,). Times are seconds in the scene's
+    clock. Geometry time is the collision evaluation epoch; force times bound
+    the solve interval. Neither is inferred from the integrated pose by clients.
+    An unavailable row (e.g. just reset) has no contacts and makes no force claim.
+
+    Each remaining array has n_contact rows. ``env_ids`` identifies the world;
+    geometry IDs index ``get_geom_names()`` in that world, never SDK objects or
+    transient native slots. Positions are world-frame meters; forces act on A
+    and B in world-frame newtons. The optional normal points from A to B;
+    signed distance is negative for penetration. Optional torques (N*m) act on
+    B about the contact point, excluding moment arms. Missing fields are None.
+    Optional ``body_ids`` identifies columns of ``body_net_force`` with shape
+    (num_envs, n_bodies, 3). This is the independent native net contact force
+    readback, never a reconstruction from the contact rows. It shares the force
+    interval and availability mask; unavailable rows contain zero placeholders.
+    Contacts are not persistent IDs, material equivalence or a convergence test.
+    """
+
+    state_time: np.ndarray
+    geometry_time: np.ndarray
+    force_start_time: np.ndarray
+    force_end_time: np.ndarray
+    available: np.ndarray
+    env_ids: np.ndarray
+    geom_a: np.ndarray
+    geom_b: np.ndarray
+    position: np.ndarray
+    force_a: np.ndarray
+    force_b: np.ndarray
+    normal: np.ndarray | None = None
+    signed_distance: np.ndarray | None = None
+    torque_b: np.ndarray | None = None
+    body_ids: np.ndarray | None = None
+    body_net_force: np.ndarray | None = None
+
+    def __post_init__(self) -> None:
+        # Snapshot arrays own their storage: retained records cannot change when
+        # the native engine steps or a caller changes the source input arrays.
+        worlds = np.asarray(self.state_time).size
+        count = np.asarray(self.env_ids).size
+        bodies = 0 if self.body_ids is None else np.asarray(self.body_ids).size
+        if (self.body_ids is None) != (self.body_net_force is None):
+            raise ValueError("body_ids and body_net_force must be present together")
+        if worlds == 0:
+            raise ValueError("contact snapshots require at least one world")
+        shape: tuple[int, ...]
+        for name in self.__dataclass_fields__:
+            value = getattr(self, name)
+            if value is None:
+                if name not in (
+                    "normal", "signed_distance", "torque_b", "body_ids", "body_net_force"
+                ):
+                    raise ValueError(f"contact {name} is required")
+                continue
+            array = np.array(value, copy=True)
+            if name in ("state_time", "geometry_time", "force_start_time", "force_end_time"):
+                shape = (worlds,)
+                kind = "f"
+            elif name == "available":
+                shape, kind = (worlds,), "b"
+            elif name in ("env_ids", "geom_a", "geom_b"):
+                shape, kind = (count,), "iu"
+            elif name == "body_ids":
+                shape, kind = (bodies,), "iu"
+            elif name == "body_net_force":
+                shape, kind = (worlds, bodies, 3), "f"
+            elif name == "signed_distance":
+                shape, kind = (count,), "f"
+            else:
+                shape, kind = (count, 3), "f"
+            if array.shape != shape or array.dtype.kind not in kind:
+                raise ValueError(f"contact {name} must have shape {shape} and dtype kind {kind}")
+            if not np.isfinite(array).all():
+                raise ValueError(f"contact {name} contains nonfinite values")
+            array.flags.writeable = False
+            object.__setattr__(self, name, array)
+        if self.body_ids is not None:
+            if np.any(self.body_ids < 0) or np.unique(self.body_ids).size != bodies:
+                raise ValueError("body_ids must be unique nonnegative public identities")
+            assert self.body_net_force is not None
+            if np.any(self.body_net_force[~self.available] != 0):
+                raise ValueError("unavailable worlds must not retain stale body forces")
+        if np.any(self.env_ids < 0) or np.any(self.env_ids >= worlds):
+            raise ValueError("contact env_ids out of range")
+        if np.any(self.geom_a < 0) or np.any(self.geom_b < 0):
+            raise ValueError("contact geometry IDs must be nonnegative")
+        if np.any(~self.available[self.env_ids]):
+            raise ValueError("unavailable worlds must not contain contacts")
+        if np.any(self.force_start_time > self.force_end_time):
+            raise ValueError("contact force interval is reversed")
+        if np.any(self.force_end_time > self.state_time):
+            raise ValueError("contact force interval extends beyond the recorded state")
+        if np.any(self.geometry_time > self.state_time):
+            raise ValueError("contact geometry epoch extends beyond the recorded state")
