@@ -0,0 +1,83 @@
+"""Collision identity must survive missing mesh names without guessing slots."""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from unisim.backend.genesis.geometry_identity import matches
+
+
+def fixture():
+    source = SimpleNamespace(
+        geom_types=(6,), geom_sizes=np.array([[.02, .03, .04]]),
+        geom_positions=np.array([[.1, .2, .3]]),
+        geom_quaternions=np.array([[1., 0., 0., 0.]]),
+    )
+    native = SimpleNamespace(
+        metadata={}, link=SimpleNamespace(name="cube"), type=SimpleNamespace(name="BOX"),
+        data=np.array([.04, .06, .08, 0, 0, 0, 0]), init_pos=np.array([.1, .2, .3]),
+        init_quat=np.array([-1., 0., 0., 0.]),
+    )
+    return native, source
+
+
+def test_unnamed_primitive_requires_exact_shape_pose_and_body():
+    native, source = fixture()
+    assert matches(native, source, 0, "collision", "cube")
+    assert not matches(native, source, 0, "collision", "other")
+    native.data[0] *= 2
+    assert not matches(native, source, 0, "collision", "cube")
+
+
+@pytest.mark.parametrize("attribute,value", [
+    ("init_pos", np.array([.1, .2, .31])),
+    ("init_quat", np.array([0., 1., 0., 0.])),
+    ("type", SimpleNamespace(name="SPHERE")),
+    ("data", np.array([np.nan, .06, .08])),
+])
+def test_unverified_primitive_identity_is_refused(attribute, value):
+    native, source = fixture()
+    setattr(native, attribute, value)
+    assert not matches(native, source, 0, "collision", "cube")
+
+
+def test_named_legacy_geometry_keeps_existing_binding():
+    native = SimpleNamespace(metadata={"name":"mesh"}, link=SimpleNamespace(name="body"))
+    assert matches(native, None, 0, "mesh", "body")
+    assert not matches(native, None, 0, "different", "body")
+
+
+def test_cached_primitive_name_cannot_override_body_shape_or_pose():
+    native, source = fixture()
+    native.metadata = {"name": "cached_left_pad"}
+    assert matches(native, source, 0, "right_pad", "cube")
+    assert not matches(native, source, 0, "right_pad", "left")
+    native.init_pos[0] += .01
+    assert not matches(native, source, 0, "cached_left_pad", "cube")
+
+
+@pytest.mark.parametrize("variant", [0, 1])
+@pytest.mark.parametrize("fixed_child", [False, True])
+def test_aligned_variant_anchor_is_removed_in_the_correct_link_frame(variant, fixed_child):
+    native, source = fixture()
+    quarter_turn = np.array([2**-.5, 0., 0., 2**-.5])
+    anchors = [SimpleNamespace(offset_pos=np.array([.71 + .01 * i, 0., 0.]),
+                               offset_quat=quarter_turn) for i in range(2)]
+    root = SimpleNamespace(name="root", parent_idx=-1, aligned=True, desc=anchors[0])
+    child = SimpleNamespace(name="cube", parent_idx=10, aligned=False,
+                            desc=SimpleNamespace(pos=np.array([.05, 0., 0.]),
+                                                 quat=np.array([1., 0., 0., 0.])))
+    entity = SimpleNamespace(links=[root, child], link_start=10,
+                             _desc=SimpleNamespace(variants=anchors),
+                             morphs=[SimpleNamespace(offset_pos=np.array([.7, 0., 0.]),
+                                                      offset_quat=np.array([1., 0., 0., 0.]))] * 2)
+    root.entity = child.entity = entity
+    native.link = child if fixed_child else root
+    native.init_pos = np.array([.15 if fixed_child else .2,
+                                -.14 if fixed_child else -.09, .3])
+    native.init_pos[1] += .01 * variant
+    native.init_quat = quarter_turn * np.array([1., 1., 1., -1.])
+    assert matches(native, source, 0, "collision", native.link.name, variant)
+    assert not matches(native, source, 0, "collision", native.link.name, 1 - variant)
