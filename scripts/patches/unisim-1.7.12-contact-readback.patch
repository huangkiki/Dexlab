+"""Precision must survive source ingestion, caches, controls and contact reduction."""
+from __future__ import annotations
+
+import random
+import xml.etree.ElementTree as ET
+from contextlib import nullcontext
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from unisim.backend.genesis import materialization
+from unisim.backend.genesis.backend import GenesisBackend, _make_device_cache
+from unisim.scene import SceneCfg
+
+
+def test_portable_xml_preserves_explicit_inertials_without_materializing_inferred_ones(tmp_path):
+    mujoco = pytest.importorskip("mujoco")
+    mass = .06400000000000002
+    inertia = 1.7066666666666674e-5
+    source = f'''<mujoco><worldbody>
+        <body name="explicit"><freejoint/>
+          <inertial pos=".0123456789012345 0 0" mass="{mass!r}"
+            diaginertia="{inertia!r} {inertia!r} {inertia!r}"/>
+          <geom type="box" size=".02 .02 .02"/>
+        </body>
+        <body name="inferred"><freejoint/><geom type="box" size=".02 .02 .02"/></body>
+        </worldbody></mujoco>'''
+    spec = mujoco.MjSpec.from_string(source)
+    expected = spec.compile()
+    path = tmp_path / "normalized.xml"
+    materialization._write_portable_source(spec, expected, str(path))
+    actual = mujoco.MjModel.from_xml_path(str(path))
+    for field in ("body_mass", "body_inertia", "body_ipos", "body_iquat"):
+        np.testing.assert_array_equal(getattr(actual, field), getattr(expected, field))
+    root = ET.parse(path)
+    assert root.find("worldbody/body[@name='inferred']/inertial") is None
+    assert actual.body("explicit").mass[0] == mass
+
+
+@pytest.fixture
+def session(monkeypatch):
+    # Restore any real session guard when this fake-session fixture finishes.
+    for name, value in (("_SESSION_ACTIVE", False), ("_SESSION_DESTROYED", False),
+                        ("_SESSION_DEVICE_ID", None), ("_SESSION_PROFILE", None)):
+        monkeypatch.setattr(materialization, name, value)
+    calls = []
+    cuda = SimpleNamespace(
+        is_available=lambda: True, current_device=lambda: 0,
+        set_device=lambda value: calls.append(("set_device", value)),
+    )
+    def initialize(**kwargs):
+        calls.append(kwargs)
+        random.seed(15)
+        np.random.seed(15)
+    deps = SimpleNamespace(
+        genesis=SimpleNamespace(cpu="cpu", gpu="gpu", init=initialize, destroy=lambda: None),
+        torch=SimpleNamespace(cuda=cuda),
+    )
+    monkeypatch.setattr(materialization, "preserve_torch_globals", lambda _: nullcontext())
+    yield deps, calls
+
+
+def test_cpu_fp64_seed_is_explicit_and_does_not_reseed_caller(session):
+    deps, calls = session
+    python_rng, numpy_rng = random.getstate(), np.random.get_state()
+    materialization.init_genesis_session(deps, device="cpu", precision="64", seed=7)
+    materialization.init_genesis_session(deps, device="cpu", precision="64", seed=7)
+    assert calls == [dict(backend="cpu", logging_level="warning", precision="64", seed=7)]
+    assert random.getstate() == python_rng
+    actual = np.random.get_state()
+    assert actual[0] == numpy_rng[0] and actual[2:] == numpy_rng[2:]
+    np.testing.assert_array_equal(actual[1], numpy_rng[1])
+
+
+@pytest.mark.parametrize("options", [
+    dict(device="gpu", precision="64", seed=7),
+    dict(device="cpu", precision="32", seed=7),
+    dict(device="cpu", precision="64", seed=8),
+])
+def test_session_conflict_rejected_without_second_init(session, options):
+    deps, calls = session
+    materialization.init_genesis_session(deps, device="cpu", precision="64", seed=7)
+    with pytest.raises(RuntimeError, match="different device, precision, seed"):
+        materialization.init_genesis_session(deps, **options)
+    assert len(calls) == 1
+
+
+def test_rejected_gpu_switch_does_not_change_current_device(session):
+    deps, calls = session
+    materialization.init_genesis_session(deps)
+    with pytest.raises(RuntimeError, match="different device"):
+        materialization.init_genesis_session(deps, device_id=1)
+    assert calls == [dict(backend="gpu", logging_level="warning", precision="32")]
+
+
+def test_destroy_does_not_allow_reinitialization(session):
+    deps, _ = session
+    materialization.init_genesis_session(deps, device="cpu")
+    materialization.destroy_genesis_session(deps)
+    with pytest.raises(RuntimeError, match="already destroyed"):
+        materialization.init_genesis_session(deps, device="cpu")
+
+
+@pytest.mark.parametrize("options", [
+    dict(device="cuda"), dict(precision=64), dict(precision="16"),
+    dict(seed=True), dict(seed=-1), dict(seed=2**32), dict(device="cpu", device_id=0),
+])
+def test_invalid_session_options_do_not_initialize(session, options):
+    deps, calls = session
+    with pytest.raises(ValueError):
+        materialization.init_genesis_session(deps, **options)
+    assert not calls
+
+
+@pytest.mark.parametrize("dtype", [np.float32, np.float64])
+def test_source_metadata_and_cache_keep_selected_precision(tmp_path, dtype):
+    mujoco = pytest.importorskip("mujoco")
+    value = 1 + 2**-30
+    model = tmp_path / "model.xml"
+    model.write_text(f'''<mujoco><option gravity="0 0 -{value}"/><worldbody>
+        <body pos="0 0 {value}"><freejoint/><geom type="sphere" size=".1"
+        mass="{value}"/></body></worldbody></mujoco>''')
+    metadata = materialization.scan_genesis_model_metadata(
+        mujoco, SceneCfg(model_file=str(model)), np_dtype=dtype
+    )
+    for array in (metadata.gravity, metadata.default_qpos, metadata.body_mass):
+        assert array.dtype == dtype
+    assert metadata.body_mass[1] == dtype(value)
+    assert metadata.gravity[2] == -dtype(value)
+    torch = SimpleNamespace(
+        float32=np.float32, float64=np.float64,
+        cuda=SimpleNamespace(is_available=lambda: False),
+        empty=lambda shape, dtype, pin_memory: SimpleNamespace(
+            numpy=lambda: np.empty(shape, dtype=dtype)
+        ),
+    )
+    _, cache = _make_device_cache(torch, (1, 3), dtype)
+    cache[:] = value
+    assert cache.dtype == dtype and cache[0, 0] == dtype(value)
+
+
+@pytest.mark.parametrize("dtype", [np.float32, np.float64])
+def test_contact_reduction_keeps_precision_orientation_and_reset_mask(dtype):
+    value = 1 + 2**-30
+    backend = object.__new__(GenesisBackend)
+    backend._np_dtype = np.dtype(dtype)
+    backend._num_envs = 2
+    backend._contact_sensor_rows_valid = np.array([True, False])
+    contacts = dict(
+        geom_a=np.array([[1, 2, 8]] * 2), geom_b=np.array([[2, 1, 9]] * 2),
+        valid_mask=np.ones((2, 3), bool),
+        force_a=np.array([[[value, 0, 0], [-value, 0, 0], [99, 0, 0]]] * 2),
+        force_b=np.array([[[-value, 0, 0], [value, 0, 0], [-99, 0, 0]]] * 2),
+    )
+    backend._sensor_contact_bindings = {"pair": SimpleNamespace(
+        netforce=True, entity1=SimpleNamespace(get_contacts=lambda _: contacts),
+        entity2=object(), geom1_ids=np.array([1, 1]), geom2_ids=np.array([2, 2]),
+    )}
+    actual = backend._read_portable_contact("pair", netforce=True)
+    assert actual.dtype == dtype
+    np.testing.assert_array_equal(actual, np.array([[2 * value, 0, 0], [0, 0, 0]], dtype=dtype))
+    contacts["force_a"][0, 0, 0] = np.nan
+    with pytest.raises(RuntimeError, match="nonfinite"):
+        backend._read_portable_contact("pair", netforce=True)
+
+
+def test_deterministic_policy_is_explicit_and_cannot_change(session):
+    deps, calls = session
+    materialization.init_genesis_session(deps, use_deterministic_algorithms=True)
+    assert calls[0]["use_deterministic_algorithms"] is True
+    with pytest.raises(RuntimeError, match="deterministic policy"):
+        materialization.init_genesis_session(deps)
+
+
+@pytest.mark.parametrize("options", [
+    dict(actuated_armature=-1.), dict(actuated_armature=float("nan")),
+    dict(actuated_armature=True), dict(noslip_iterations=-1), dict(noslip_iterations=True),
+    dict(actuated_armature="0"), dict(actuated_armature=[0]),
+    dict(use_deterministic_algorithms=1),
+])
+def test_invalid_physical_options_rejected_before_optional_import(options):
+    with pytest.raises(ValueError):
+        GenesisBackend(SceneCfg(model_file="does-not-exist.xml"), 1, .001, **options)
