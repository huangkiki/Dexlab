@@ -0,0 +1,101 @@
+"""Genesis rigid contact translation, owned entirely by the engine adapter."""
+from __future__ import annotations
+
+from typing import Any
+
+import numpy as np
+
+from unisim.contacts import ContactSnapshot
+
+
+def geometry_map(backend: Any) -> np.ndarray:
+    """Map every active native collision identity to the public per-world layout."""
+    solver = backend._scene.rigid_solver
+    mapping = np.full((backend._num_envs, solver.n_geoms), -1, dtype=np.int64)
+    layout = backend._entity_layout
+    for owner in layout.entities:
+        runtime = backend._entity_runtimes[owner.name]
+        if runtime.is_visual_mirror:
+            continue
+        public = layout.get_geom_ids(tuple(geom.name for geom in owner.geoms), entity=owner.name)
+        for row in range(backend._num_envs):
+            variant = 0 if len(runtime.source_metadata) == 1 else backend._variant_assignment[row]
+            native = runtime.collision_geom_indices[variant]
+            valid = native >= 0
+            selected = native[valid]
+            if np.unique(selected).size != selected.size or np.any(mapping[row, selected] >= 0):
+                raise RuntimeError("Genesis contact geometry mapping is ambiguous")
+            mapping[row, selected] = np.asarray(public, dtype=np.int64)[valid]
+    return mapping
+
+
+def snapshot(backend: Any) -> ContactSnapshot:
+    """Copy native contact slots without collision detection or forward recomputation.
+
+    Genesis 1.4.3 computes contacts before integrating each rigid substep. Its
+    native normal points B->A; its native force acts on B. The public normal is
+    reversed to A->B and signed distance is minus the native penetration.
+    """
+    raw = backend._scene.rigid_solver.collider.get_contacts(
+        as_tensor=True, to_torch=True, is_padded=True
+    )
+
