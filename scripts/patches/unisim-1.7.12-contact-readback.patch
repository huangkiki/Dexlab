+"""Complete-contact records reject invented identity, epochs and missing fields."""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from unisim import ContactSnapshot, FakeBackend, UnsupportedCapabilityError
+
+
+def sample(**overrides):
+    values = dict(
+        state_time=np.array([1.0]), geometry_time=np.array([0.9]),
+        force_start_time=np.array([0.9]), force_end_time=np.array([1.0]),
+        available=np.array([True]), env_ids=np.array([0]), geom_a=np.array([0]),
+        geom_b=np.array([1]), position=np.zeros((1, 3)), force_a=np.array([[0., 0., -1.]]),
+        force_b=np.array([[0., 0., 1.]]),
+    )
+    return ContactSnapshot(**(values | overrides))
+
+
+def test_snapshot_owns_storage_and_missing_is_not_zero():
+    positions = np.ones((1, 3))
+    result = sample(position=positions)
+    positions[:] = 42
+    np.testing.assert_array_equal(result.position, [[1, 1, 1]])
+    assert not result.position.flags.writeable
+    assert result.normal is None and result.signed_distance is None and result.torque_b is None
+
+
+@pytest.mark.parametrize("overrides", [
+    dict(env_ids=np.array([1])), dict(env_ids=np.array([0.])),
+    dict(geom_b=np.array([-1])), dict(available=np.array([False])),
+    dict(force_start_time=np.array([1.1])), dict(force_end_time=np.array([1.1])),
+    dict(geometry_time=np.array([1.1])), dict(force_b=np.array([[np.nan, 0., 0.]])),
+    dict(position=np.array([0., 0., 0.])), dict(signed_distance=np.zeros((1, 1))),
+])
+def test_malformed_snapshot_fails_closed(overrides):
+    with pytest.raises(ValueError):
+        sample(**overrides)
+
+
+def test_unsupported_backend_does_not_return_an_empty_success():
+    backend = FakeBackend()
+    assert not backend.get_contact_capabilities().supported
+    with pytest.raises(UnsupportedCapabilityError):
+        backend.get_contact_snapshot()
+
+
+@pytest.mark.parametrize("overrides", [
+    dict(body_ids=np.array([1])), dict(body_net_force=np.zeros((1, 1, 3))),
+    dict(body_ids=np.array([1, 1]), body_net_force=np.zeros((1, 2, 3))),
+    dict(body_ids=np.array([-1]), body_net_force=np.zeros((1, 1, 3))),
+    dict(body_ids=np.array([1]), body_net_force=np.zeros((1, 3))),
+])
+def test_body_net_force_requires_complete_unique_identity(overrides):
+    with pytest.raises(ValueError):
+        sample(**overrides)
+
+
+def test_body_force_readback_is_detached_without_imposing_ledger_equality():
+    forces = np.full((1, 1, 3), 2.0)
+    result = sample(body_ids=np.array([1]), body_net_force=forces)
+    forces[:] = 90
+    np.testing.assert_array_equal(result.body_net_force, np.full((1, 1, 3), 2.0))
+    assert not result.body_net_force.flags.writeable
