+        state_time=state_time, geometry_time=start,
+        force_start_time=start, force_end_time=state_time,
+        available=available, env_ids=rows, geom_a=public_a, geom_b=public_b,
+        position=field("position", (3,)), force_a=-force, force_b=force,
+        normal=-field("normal", (3,)), signed_distance=-field("penetration", ()),
+        # The rigid contact getter has no independent contact-torque measurement.
+        torque_b=None, body_ids=body_ids, body_net_force=body_force,
+    )
