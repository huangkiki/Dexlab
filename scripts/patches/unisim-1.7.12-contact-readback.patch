index 0000000000000000000000000000000000000000..641f0631fe211e128098efed4afc9efb5a0e6952
--- /dev/null
+++ b/tests/adapters/genesis/test_contact_snapshot.py
@@ -0,0 +1,76 @@
+"""Translate a complete native contact buffer without advancing the engine."""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from unisim.backend.genesis.contacts import snapshot
+
+
+def backend():
+    raw = dict(
+        n_contacts=np.array([1, 2, 0]),
+        geom_a=np.array([[4, 999], [2, 4], [999, 999]]),
+        geom_b=np.array([[2, 999], [4, 2], [999, 999]]),
+        position=np.ones((3, 2, 3)), normal=np.broadcast_to([0., 0., -1.], (3, 2, 3)).copy(),
+        force=np.broadcast_to([0., 0., 5. + 2**-30], (3, 2, 3)).copy(),
+        penetration=np.ones((3, 2)) * .001,
+    )
+    # Padded/invalid slots may contain stale data, even NaNs, and are not observations.
+    raw["force"][0, 1] = np.nan
+    native_map = np.full((3, 5), -1, dtype=int)
+    native_map[:, 2], native_map[:, 4] = 10, 20
+    calls = []
+    def get_contacts(**kwargs):
+        calls.append(kwargs)
+        return raw
+    value = SimpleNamespace(
+        _num_envs=3, _scene=SimpleNamespace(rigid_solver=SimpleNamespace(
+            collider=SimpleNamespace(get_contacts=get_contacts))),
+        _contact_geometry_map=native_map, _time_cache=np.array([.2, .3, .4]),
+        _sim_dt=.001, _contact_sensor_rows_valid=np.array([True, False, True]),
+        _entity_runtimes={"body": SimpleNamespace(body_ids=np.array([1]), is_visual_mirror=False)},
+        _contact_force_cache=(None, np.full((3, 2, 3), 7.25)),
+    )
+    return value, raw, calls
+
+
+def test_snapshot_respects_native_counts_reset_rows_precision_and_epochs():
+    value, raw, calls = backend()
+    result = snapshot(value)
+    np.testing.assert_array_equal(result.env_ids, [0])
+    np.testing.assert_array_equal(result.geom_a, [20])
+    np.testing.assert_array_equal(result.geom_b, [10])
+    np.testing.assert_array_equal(result.normal, [[0, 0, 1]])
+    np.testing.assert_array_equal(result.signed_distance, [-.001])
+    np.testing.assert_array_equal(result.force_b, [[0, 0, 5 + 2**-30]])
+    np.testing.assert_array_equal(result.force_a, -result.force_b)
+    np.testing.assert_allclose(result.geometry_time, [.199, .3, .399], rtol=0, atol=1e-16)
+    np.testing.assert_array_equal(result.force_end_time, result.state_time)
+    assert result.torque_b is None
+    np.testing.assert_array_equal(result.body_ids, [1])
+    np.testing.assert_array_equal(result.body_net_force[:, 0], [[7.25]*3, [0.]*3, [7.25]*3])
+    value._contact_force_cache[1][:] = 99
+    assert result.body_net_force[0, 0, 0] == 7.25
+    assert calls == [dict(as_tensor=True, to_torch=True, is_padded=True)]
+    raw["force"][:] = 99
+    assert result.force_b[0, 2] == 5 + 2**-30
+
+
+@pytest.mark.parametrize("damage", ["identity", "count", "nonfinite", "unmapped", "shape"])
+def test_invalid_live_native_contacts_are_not_silently_dropped(damage):
+    value, raw, _ = backend()
+    if damage == "identity":
+        raw["geom_a"][0, 0] = 999
+    elif damage == "count":
+        raw["n_contacts"][0] = 3
+    elif damage == "nonfinite":
+        raw["force"][0, 0] = np.nan
+    elif damage == "unmapped":
+        value._contact_geometry_map[0, 4] = -1
+    else:
+        raw["normal"] = np.zeros((3, 2))
+    with pytest.raises((RuntimeError, ValueError)):
