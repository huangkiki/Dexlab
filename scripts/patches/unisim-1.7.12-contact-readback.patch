+        value = raw[name]
+        if hasattr(value, "detach"):
+            value = value.detach().cpu().numpy()
+        return np.asarray(value)
+
+    counts = array("n_contacts")
+    geom_a, geom_b = array("geom_a"), array("geom_b")
+    worlds = backend._num_envs
+    if (
+        geom_a.ndim != 2 or geom_a.shape != geom_b.shape or geom_a.shape[0] != worlds
+        or counts.shape != (worlds,) or counts.dtype.kind not in "iu"
+        or np.any(counts < 0) or np.any(counts > geom_a.shape[1])
+        or geom_a.dtype.kind not in "iu" or geom_b.dtype.kind not in "iu"
+    ):
+        raise RuntimeError("Genesis returned malformed contact counts or identities")
+    available = backend._contact_sensor_rows_valid.copy()
+    valid = (np.arange(geom_a.shape[1])[None, :] < counts[:, None]) & available[:, None]
+    rows, slots = np.nonzero(valid)
+    mapping = backend._contact_geometry_map
+    if mapping is None:
+        mapping = geometry_map(backend)
+        backend._contact_geometry_map = mapping
+    native_a, native_b = geom_a[rows, slots], geom_b[rows, slots]
+    if (
+        np.any(native_a < 0) or np.any(native_b < 0)
+        or np.any(native_a >= mapping.shape[1]) or np.any(native_b >= mapping.shape[1])
+    ):
+        raise RuntimeError("Genesis returned out-of-range native contact identities")
+    public_a, public_b = mapping[rows, native_a], mapping[rows, native_b]
+    if np.any(public_a < 0) or np.any(public_b < 0):
+        raise RuntimeError("Genesis contact geometry is not bound to the public layout")
+
+    def field(name: str, dimensions: tuple[int, ...]) -> np.ndarray:
+        values = array(name)
+        if values.shape != geom_a.shape + dimensions or values.dtype.kind != "f":
+            raise RuntimeError(f"Genesis returned malformed contact {name}")
+        return values[rows, slots]
+
+    force = field("force", (3,))
+    state_time = backend._time_cache.copy()
+    start = np.where(available, state_time - backend._sim_dt, state_time)
+    body_ids = np.concatenate([
+        runtime.body_ids for runtime in backend._entity_runtimes.values()
+        if not runtime.is_visual_mirror
+    ])
+    # The host cache comes from get_links_net_contact_force at the same barrier,
+    # independently of the padded per-contact ledger read above.
+    body_force = backend._contact_force_cache[1][:, body_ids].copy()
+    body_force[~available] = 0
