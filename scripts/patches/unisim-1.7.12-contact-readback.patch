+"""SDK evolution must preserve selected worlds, force frames and torque scope."""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from unisim.backend.genesis.backend import GenesisBackend
+
+
+@pytest.mark.parametrize("unified", [False, True])
+def test_force_and_torque_keep_com_frame_and_selected_worlds(unified):
+    calls = []
+    solver = SimpleNamespace()
+    if unified:
+        solver.apply_links_external_wrench = lambda **kwargs: calls.append(kwargs)
+    else:
+        solver.apply_links_external_force = lambda force, **kwargs: calls.append(
+            dict(force=force, **kwargs))
+        solver.apply_links_external_torque = lambda torque, **kwargs: calls.append(
+            dict(torque=torque, **kwargs))
+    backend = object.__new__(GenesisBackend)
+    backend._scene = SimpleNamespace(sim=SimpleNamespace(rigid_solver=solver))
+    backend._gs = SimpleNamespace(link_ref_frame=SimpleNamespace(link_COM=11, link_origin=12))
+    force, torque = np.ones((1, 2, 3)), np.full((1, 2, 3), .1)
+    backend._apply_native_wrench(force, torque, [4, 7], [2])
+    assert len(calls) == (1 if unified else 2)
+    for call in calls:
+        assert call['links_idx'] == [4, 7] and call['envs_idx'] == [2]
+        assert call['local'] is False
+        assert call['ref'] == (11 if unified else 'link_com')
+    assert calls[0]['force'] is force
+    assert calls[-1]['torque'] is torque
+
+
+def test_reset_with_no_pending_wrench_never_calls_native_solver():
+    backend = object.__new__(GenesisBackend)
+    backend._portable_pending_body_forces = np.zeros((2, 3, 3))
+    backend._portable_pending_body_torques = np.zeros((2, 3, 3))
+    # No scene exists: an unnecessary native invocation fails this test.
+    backend._cancel_portable_body_wrenches(np.array([0]))
