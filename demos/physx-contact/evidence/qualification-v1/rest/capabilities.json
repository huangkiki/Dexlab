    {
      "feature": "entity.multiple",
      "support": "exact",
      "reason": "Mapped MJCF scalar-joint entity scenes; worker audits native layout, inertials and identity. Variants use immutable construction-time assignments; IsaacSim materializes each unique assignment as a K-prototype catalog. Unsupported source/root/geometry profiles fail closed. Per-environment reset domain randomization covers geometry friction, body mass/COM/inertia, drive kp/kd and joint damping/armature/friction; per-variant drive gains are written at spawn and audited per environment.",
      "conditions": [
        {
          "key": "entity.asset_format",
          "value": "mjcf"
        }
      ],
      "evidence": [
        {
          "kind": "source",
          "source": "https://github.com/unilabsim/unisim/issues/108",
          "scope": {
            "adapter": "isaacsim",
